<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Agathe Tripier – Faisons connaissance</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#FBF9F6;--card:#fff;--soft:#EDEBFA;--lav:#9C9ED0;--lav-l:#DAD7F7;--vio:#5646B8;--coral:#D9582B;--peach:#FDE3D2;--ink:#2B2833;--mute:#6A6674;--warm:#F2A97B;--line:#DEDCEA;
--h:"Bricolage Grotesque","Trebuchet MS",sans-serif;--b:"Figtree","Segoe UI",Arial,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#17151F;--card:#201D2B;--soft:#262336;--lav-l:#2E2B47;--vio:#B9B7F0;--ink:#EEEDF4;--mute:#A9A5B8;--line:#3A3652;--coral:#FF9A6B;--peach:#2D2530}}
:root[data-theme="dark"]{--bg:#17151F;--card:#201D2B;--soft:#262336;--lav-l:#2E2B47;--vio:#B9B7F0;--ink:#EEEDF4;--mute:#A9A5B8;--line:#3A3652;--coral:#FF9A6B;--peach:#2D2530}
html{scroll-behavior:smooth;scroll-padding-top:calc(80px + env(safe-area-inset-top,0px))}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 18px/1.65 var(--b);-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,p{margin:0}
h1,h2,h3{font-family:var(--h);letter-spacing:-.025em;line-height:1.05}
a{color:inherit}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
:focus-visible{outline:3px solid var(--vio);outline-offset:3px;border-radius:6px}
header{position:fixed;top:0;left:0;right:0;z-index:20;padding-top:env(safe-area-inset-top,0px);background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(10px)}
.bar{display:flex;align-items:center;justify-content:space-between;height:66px;gap:16px}
.logo{font:800 19px var(--h);text-decoration:none;color:var(--vio)}
nav{display:flex;gap:26px;font-weight:500;font-size:15px}
nav a{text-decoration:none;opacity:.8}nav a:hover{opacity:1;text-decoration:underline;text-underline-offset:5px}
.btn{display:inline-block;border-radius:999px;padding:13px 26px;font:600 15px var(--b);text-decoration:none;border:2px solid var(--vio);transition:transform .2s;background:transparent;color:var(--vio)}
.btn:hover{transform:translateY(-2px)}
.btn.p{background:var(--vio);color:var(--bg)}
.btn.sm{padding:8px 18px;font-size:14px}

/* hero */
#accueil{min-height:100svh;display:flex;align-items:center;padding:110px 0 70px;background:radial-gradient(60% 55% at 88% 15%,var(--lav-l),transparent 70%),radial-gradient(45% 45% at 0% 100%,var(--peach),transparent 70%)}
.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center}
h1{font-size:clamp(20px,2vw,24px);font-weight:600;color:var(--vio);margin-bottom:22px}
.say-hero{font:800 clamp(38px,6.2vw,80px)/1.02 var(--h);letter-spacing:-.035em}
.say-hero span{display:block;opacity:0;transform:translateY(34px);animation:rise 1s cubic-bezier(.2,.7,.2,1) forwards}
.say-hero span:nth-child(1){animation-delay:.15s}.say-hero span:nth-child(2){animation-delay:.6s;color:var(--vio)}.say-hero span:nth-child(3){animation-delay:1.05s;color:var(--coral)}
@keyframes rise{to{opacity:1;transform:none}}
.go{display:inline-block;margin-top:40px;font-weight:600;color:var(--vio);text-decoration:none;opacity:0;animation:rise .8s 1.7s forwards}
.go::after{content:"";display:block;height:2px;background:var(--vio);margin-top:4px;transform-origin:left;animation:line 2.4s 2.2s ease-in-out infinite}
@keyframes line{0%,100%{transform:scaleX(.25)}50%{transform:scaleX(1)}}
.portrait{position:relative;max-width:400px;margin-left:auto;width:100%;aspect-ratio:4/5;opacity:0;animation:rise 1.2s .3s forwards}
.portrait::before{content:"";position:absolute;inset:-6% -9% 7% 11%;background:var(--lav-l);border-radius:48% 52% 44% 56%/52% 44% 56% 48%;animation:morph 14s ease-in-out infinite alternate}
.portrait::after{content:"";position:absolute;width:70px;height:70px;border-radius:50%;background:var(--warm);right:-14px;bottom:11%}
@keyframes morph{to{border-radius:56% 44% 52% 48%/44% 56% 44% 56%;transform:rotate(3deg)}}
.portrait img{position:relative;z-index:1;width:100%;height:100%;object-fit:cover;object-position:50% 28%;border-radius:200px 200px 28px 28px;display:block}

/* portrait en traits */
#portrait{padding:60px 0 40px}
.story{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px}
.sticky{position:sticky;top:calc(90px + env(safe-area-inset-top,0px));height:calc(100svh - 150px);display:flex;flex-direction:column;justify-content:center}
.word{position:relative;height:1.1em;font:800 clamp(52px,8vw,108px)/1 var(--h);letter-spacing:-.04em;color:var(--vio)}
.word span{position:absolute;left:0;top:0;white-space:nowrap;opacity:0;transform:translateY(40%);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)}
.word span.on{opacity:1;transform:none}.word span:nth-child(even){color:var(--coral)}
.dots{display:flex;gap:10px;margin-top:34px}
.dots i{width:10px;height:10px;border-radius:50%;background:var(--lav-l);transition:all .4s}
.dots i.on{background:var(--warm);width:34px;border-radius:6px}
.say{min-height:78svh;display:flex;flex-direction:column;justify-content:center;opacity:.2;transition:opacity .5s}
.say.on{opacity:1}
.say h2{font-size:clamp(30px,4.2vw,50px);font-weight:800;max-width:15ch}
.say p{color:var(--mute);margin-top:20px;max-width:46ch}

.polas{position:relative;width:min(220px,60%);aspect-ratio:4/5;margin-top:38px}
.polas img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#fff;border:8px solid #fff;border-bottom-width:30px;border-radius:6px;box-shadow:0 16px 34px rgba(70,50,150,.22);opacity:0;transform:rotate(5deg) scale(.92);transition:opacity .5s,transform .7s cubic-bezier(.2,.7,.2,1)}
.polas img.on{opacity:1;transform:rotate(-3deg)}
/* ailleurs */
#ailleurs{background:var(--peach);padding:100px 0 110px;overflow:hidden}
#ailleurs h2{font-size:clamp(30px,4.2vw,50px);font-weight:800;max-width:20ch}
.collage{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:56px;align-items:start}
.fig{margin:0;background:var(--card);padding:10px 10px 0;border-radius:8px;box-shadow:0 18px 40px rgba(120,60,30,.18);opacity:0;transform:translateY(50px) rotate(var(--r));transition:opacity .8s,transform .9s cubic-bezier(.2,.7,.2,1)}
.fig.on{opacity:1;transform:rotate(var(--r))}
.fig.on:hover{transform:rotate(0) scale(1.03)}
.fig:nth-child(2){margin-top:64px}.fig:nth-child(3){margin-top:22px}
.fig img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:3px}
.fig figcaption{font:800 20px var(--h);padding:14px 0 16px;text-align:center;color:var(--vio)}
/* parcours */
#parcours{padding:90px 0 40px;background:var(--soft)}
#parcours h2,#details h2{font-size:clamp(30px,4.2vw,50px);font-weight:800;max-width:18ch}
.sub{color:var(--mute);margin-top:14px;max-width:50ch}
.rows{margin-top:44px;border-top:1px solid var(--line)}
details{border-bottom:1px solid var(--line)}
summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:130px 1fr 36px;gap:20px;align-items:center;padding:26px 0}
summary::-webkit-details-marker{display:none}
.d{font:700 16px var(--h);color:var(--vio)}
summary h3{font-size:clamp(21px,2.6vw,28px);font-weight:800}
summary small{display:block;color:var(--mute);font:400 16px var(--b);margin-top:4px}
summary::after{content:"+";font:400 30px/1 var(--h);color:var(--vio);justify-self:end;transition:transform .3s}
details[open] summary::after{transform:rotate(45deg)}
details ul{margin:0 0 28px 150px;padding-left:20px;color:var(--mute);max-width:56ch}
details li{margin:6px 0}details li::marker{color:var(--lav)}
details[open] ul{animation:rise .5s both}

/* détails */
#details{padding:90px 0 40px}
.facts{display:grid;grid-template-columns:repeat(2,1fr);gap:40px;margin-top:44px}
.facts h3{font-size:19px;color:var(--vio);margin-bottom:12px}
.facts p{color:var(--mute);font-size:17px;margin-top:6px}
.facts p b{color:var(--ink);font-weight:600}

/* contact */
#contact{padding:70px 0}
.cbox{background:linear-gradient(150deg,var(--vio),#6B66B0);color:#fff;border-radius:36px;padding:clamp(34px,6vw,72px);position:relative;overflow:hidden}
.cbox::after{content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;background:var(--warm);opacity:.28}
.cbox h2{font-size:clamp(32px,4.6vw,56px);font-weight:800;max-width:16ch;position:relative}
.cbox p{position:relative;max-width:52ch;margin-top:18px;color:#ECEBFA}
.coord{position:relative;list-style:none;padding:0;margin:26px 0 0;display:grid;gap:6px;font-weight:500}
.coord a{text-underline-offset:4px}
.cta{position:relative;display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.cbox .btn{color:#fff;border-color:#fff}.cbox .btn.p{background:#fff;color:#4B4585}
.ref{font-size:15px;color:#DCDAF3}
footer{text-align:center;color:var(--mute);font-size:14px;padding:10px 24px 40px}

@media (max-width:860px){
 nav{display:none}
 #accueil{padding-top:96px}
 .hero,.story,.facts{grid-template-columns:1fr}
 .portrait{order:-1;max-width:280px;margin:0 auto 10px}
 .sticky{display:none}
 .collage{grid-template-columns:1fr;max-width:330px;margin-inline:auto;gap:38px}.fig:nth-child(n){margin-top:0}
 .say{min-height:0;opacity:1;padding:34px 0}
 summary{grid-template-columns:1fr 30px}.d{grid-column:1/-1}
 summary::after{grid-row:2;grid-column:2}
 details ul{margin-left:0}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.say-hero span,.go,.portrait{opacity:1;transform:none}.fig{opacity:1;transform:rotate(var(--r))}html{scroll-behavior:auto}}
</style>
</head>
<body>
<header><div class="wrap bar">
 <a class="logo" href="#accueil">Agathe Tripier</a>
 <nav aria-label="Navigation principale"><a href="#portrait">Portrait</a><a href="#ailleurs">Ailleurs</a><a href="#parcours">Parcours</a><a href="#details">En bref</a><a href="#contact">Contact</a></nav>
 <a class="btn p sm" href="CV_AT_2026.pdf" download>Mon CV</a>
</div></header>

<main>
<section id="accueil"><div class="wrap hero">
 <div>
  <h1>Agathe Tripier</h1>
  <p class="say-hero"><span>Organisée dans mon travail,</span><span>spontanée dans mes relations,</span><span>proactive dans mes missions.</span></p>
  <a class="go" href="#portrait">Faisons connaissance</a>
 </div>
 <div class="portrait"><img src="data:image/jpeg;base64," alt="Portrait d’Agathe Tripier, souriante, cheveux longs ondulés, blazer noir" width="720" height="900"></div>
</div></section>

<section id="portrait"><div class="wrap story">
 <div class="sticky" aria-hidden="true">
  <div class="word"><span>Sociable</span><span>Proactive</span><span>Organisée</span><span>Positive</span><span>Pédagogue</span><span>Polyvalente</span></div>
  <div class="dots"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="polas"><img alt=""><img alt=""><img alt=""></div>
 </div>
 <div>
  <div class="say"><h2>Je vais vers les gens.</h2><p>Clients, collègues, partenaires : j’aime comprendre ce dont chacun a besoin et m’adapter à mon interlocuteur. Je soigne la qualité de la relation.</p></div>
  <div class="say"><h2>Je n’attends pas qu’on me dise quoi faire.</h2><p>Comprendre un besoin, anticiper la suite, chercher une solution : c’est comme ça que j’avance.</p></div>
  <div class="say"><h2>J’aime quand ça aboutit.</h2><p>Structurer, prioriser, suivre, puis finaliser. Voir un dossier arriver au bout fait partie de ce qui me motive.</p></div>
  <div class="say"><h2>J’arrive avec de la bonne humeur.</h2><p>L’entraide, la communication et une ambiance positive comptent beaucoup pour moi. Je partage l’information et je fais avancer les sujets avec les autres.</p></div>
  <div class="say"><h2>Ce que j’apprends, je le transmets.</h2><p>Chez Grom, puis chez We Audition, j’ai formé et accompagné les nouveaux arrivants.</p></div>
  <div class="say"><h2>Je change de décor sans perdre le fil.</h2><p>Une glacerie, des cabinets d’audioprothèse, des appels d’offres sur l’eau potable : trois univers, et chaque fois la même envie que les choses se passent bien pour les clients et pour l’équipe.</p></div>
 </div>
</div></section>

<section id="ailleurs"><div class="wrap">
 <h2>Quand je lève le nez du travail, je pars voir ailleurs.</h2>
 <p class="sub">Le voyage fait partie de moi : l’Égypte, ses temples et ses tombes, puis la neige et les sports d’hiver. Au quotidien, il y a le Pilates et le développement personnel.</p>
 <div class="collage">
  <figure class="fig" style="--r:-3deg"><img src="data:image/jpeg;base64," alt="Agathe de dos, chapeau noir, dans une tombe égyptienne couverte de hiéroglyphes peints" loading="lazy"><figcaption>Égypte</figcaption></figure>
  <figure class="fig" style="--r:2.5deg"><img src="data:image/jpeg;base64," alt="Agathe souriante, casquette et lunettes de soleil, devant un temple égyptien" loading="lazy"><figcaption>Égypte</figcaption></figure>
  <figure class="fig" style="--r:-2deg"><img src="data:image/jpeg;base64," alt="Agathe en tenue de ski, casque et masque, face aux montagnes enneigées" loading="lazy"><figcaption>Sports d’hiver</figcaption></figure>
 </div>
</div></section>

<section id="parcours"><div class="wrap">
 <h2>Les trois décors où tout ça s’est joué.</h2>
 <p class="sub">Pour celles et ceux qui veulent les détails : ouvrez une ligne.</p>
 <div class="rows">
  <details><summary><span class="d">2025 – 2026</span><div><h3>Saur, service de l’eau</h3><small>Alternante, administration des ventes / support commercial · Serris</small></div></summary>
   <ul><li>Gestion des appels d’offres eau potable et assainissement, préparation des dossiers de réponse</li><li>Coordination avec les chargés d’affaires et les équipes techniques</li><li>Gestion administrative et conformité documentaire</li><li>Organisation des visites de site et suivi des dossiers</li></ul></details>
  <details><summary><span class="d">2021 – 2023</span><div><h3>We Audition</h3><small>Assistante administrative &amp; commerciale, formatrice · Claye-Souilly, Pontault-Combault, Torcy</small></div></summary>
   <ul><li>Gestion administrative et financière de plusieurs centres</li><li>Relation client, suivi des dossiers et facturation</li><li>Gestion du SAV et du tiers payant</li><li>Formation et accompagnement des nouvelles collaboratrices</li></ul></details>
  <details><summary><span class="d">2019 – 2020</span><div><h3>Grom</h3><small>Vendeuse, formatrice · Serris</small></div></summary>
   <ul><li>Conseil et accompagnement des clients</li><li>Gestion des encaissements et des stocks</li><li>Formation des nouveaux collaborateurs</li><li>Respect des procédures qualité</li></ul></details>
 </div>
</div></section>

<section id="details"><div class="wrap">
 <h2>Le reste, en bref.</h2>
 <div class="facts">
  <div><h3>Formation</h3><p><b>2025 – 2026</b><br>Licence professionnelle Management opérationnel des organisations</p><p><b>2024 – 2026</b><br>BTS Management Commercial Opérationnel</p></div>
  <div><h3>Outils</h3><p>Microsoft 365, Excel, Word, Outlook, PowerPoint, SharePoint, plateformes d’appels d’offres, Canva, CRM</p><p><b>Anglais</b> · niveau B1</p></div>
 </div>
</div></section>

<section id="contact"><div class="wrap"><div class="cbox">
 <h2>Et si nous faisions connaissance ?</h2>
 <p>Je recherche un CDI en gestion administrative, coordination ou support opérationnel, à Caen et alentours.</p>
 <ul class="coord"><li><a href="mailto:agathe.tripier@gmail.com">agathe.tripier@gmail.com</a></li><li><a href="tel:+33658434653">06 58 43 46 53</a></li><li>Caen et alentours · Permis B, véhicule personnel</li></ul>
 <div class="cta"><a class="btn p" href="mailto:agathe.tripier@gmail.com">M’envoyer un e-mail</a><a class="btn" href="CV_AT_2026.pdf" download>Télécharger mon CV</a><a class="btn" href="tel:+33658434653">M’appeler</a></div>
 <p class="ref">Références professionnelles disponibles sur demande.</p>
</div></div></section>
</main>
<footer>© 2026 Agathe Tripier</footer>

<script>
(function(){
 var says=[].slice.call(document.querySelectorAll('.say')),ws=document.querySelectorAll('.word span'),ds=document.querySelectorAll('.dots i');
 var set=function(i){says.forEach(function(s,j){s.classList.toggle('on',j===i)});[].forEach.call(ws,function(w,j){w.classList.toggle('on',j===i)});[].forEach.call(ds,function(d,j){d.classList.toggle('on',j===i)})};
 var ps=document.querySelectorAll('.polas img'),fs=document.querySelectorAll('.fig img');
 [].forEach.call(ps,function(p,k){p.src=fs[k].src});
 var _s=set;set=function(i){_s(i);[].forEach.call(ps,function(p,k){p.classList.toggle('on',k===i%3)})};
 var figs=document.querySelectorAll('.fig');
 if('IntersectionObserver' in window){var fo=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');fo.unobserve(e.target)}})},{threshold:.2});[].forEach.call(figs,function(f){fo.observe(f)})}else{[].forEach.call(figs,function(f){f.classList.add('on')})}
 set(0);
 if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)set(says.indexOf(e.target))})},{rootMargin:'-42% 0px -42% 0px'});
  says.forEach(function(s){io.observe(s)});
 }
})();
</script>
</body>
</html>
